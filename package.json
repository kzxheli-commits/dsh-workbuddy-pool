{
  "name": "dsh-workbuddy-pool",
  "displayName": "WorkBuddy Pool",
  "description": "把本机/导入的 WorkBuddy 账号合并成一个自动故障转移的模型池，以回环 OpenAI/Anthropic 兼容端点接入 DeepSeek Harness（多账号轮换、积分、签到、扫码登录）。",
  "version": "0.4.40",
  "license": "MIT",
  "private": false,
  "author": "dsh-workbuddy-pool contributors",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workbuddy",
    "codebuddy",
    "llm",
    "failover"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "CODE_REVIEW.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "meta": {
    "title": "WorkBuddy Pool",
    "description": "WorkBuddy 账号池反代：多账号轮换与故障转移，OpenAI / Anthropic 兼容端点，设置卡片内导入与扫码登录。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": ">=0.82.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "check:provider": "node test/check-provider.mjs",
    "check:client": "node test/check-client-static.mjs",
    "check": "node test/run.mjs && node test/check-provider.mjs && node test/check-client-static.mjs"
  },
  "icon": "./icon.png"
}
